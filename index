                                                            { id: 'green', name: 'Hijau', color: 'bg-[#16a34a]' },
                                                            { id: 'purple', name: 'Ungu', color: 'bg-[#9333ea]' },
                                                            { id: 'orange', name: 'Oranye', color: 'bg-[#ea580c]' },
                                                            { id: 'dark', name: 'Monokrom / Gelap', color: 'bg-[#52525b]' }
                                                        ].map(theme => (
                                                            <button 
                                                                key={theme.id}
                                                                onClick={() => setSettings({...settings, themeColor: theme.id})}
                                                                className={`w-10 h-10 rounded-full ${theme.color} shadow-sm border-2 flex items-center justify-center transition-all ${settings.themeColor === theme.id ? 'border-zinc-900 scale-110' : 'border-transparent hover:scale-105 opacity-80 hover:opacity-100'}`}
                                                                title={theme.name}
                                                            >
                                                                {settings.themeColor === theme.id && <svg className="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={3} d="M5 13l4 4L19 7" /></svg>}
                                                            </button>
                                                        ))}
                                                    </div>
                                                </div>

                                                <div>
                                                    <label className="text-xs font-bold text-zinc-500 uppercase">Latar Belakang (Warna Hex atau URL Gambar)</label>
                                                    <input type="text" value={settings.appBackground || ''} onChange={e => setSettings({...settings, appBackground: e.target.value})} placeholder="Contoh: #f4f4f5 atau https://..." className="w-full mt-1 p-3 rounded-xl border border-zinc-300 focus:border-brand-500 outline-none text-sm font-medium" />
                                                    <p className="text-xs text-zinc-400 mt-2">Masukkan kode warna (misal: <b className="text-zinc-600">#f4f4f5</b>, <b className="text-zinc-600">white</b>) atau link gambar URL untuk mengubah latar belakang aplikasi secara keseluruhan.</p>
                                                </div>
                                            </div>

                                            <div className="bg-white p-6 rounded-3xl shadow-sm border border-zinc-200">
                                                <div className="flex justify-between items-center mb-4 border-b border-zinc-100 pb-2">
                                                    <h3 className="font-black text-lg text-zinc-800">Metode Pembayaran Aktif</h3>
                                                </div>
                                                <div className="space-y-3">
                                                    {paymentMethods.map(pm => (
                                                        <div key={pm.id} className={`flex items-center justify-between p-4 rounded-xl border ${pm.isActive ? 'border-brand-200 bg-brand-50/30' : 'border-zinc-200 bg-zinc-50 opacity-60'}`}>
                                                            <div>
                                                                <h4 className="font-bold text-zinc-800">{pm.name}</h4>
                                                            <p className="text-xs font-medium text-zinc-500 uppercase mt-0.5">Tipe: {pm.type}</p>
                                                            </div>
                                                            <label className="relative inline-flex items-center cursor-pointer">
                                                            <input type="checkbox" className="sr-only peer" checked={pm.isActive} onChange={() => {
                                                                setPaymentMethods(paymentMethods.map(p => p.id === pm.id ? { ...p, isActive: !p.isActive } : p));
                                                            }} />
                                                            <div className="w-11 h-6 bg-zinc-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-600"></div>
                                                        </label>
                                                    </div>
                                                ))}
                                                <p className="text-xs text-zinc-500 italic pt-2">*Metode yang dinonaktifkan tidak akan muncul di halaman checkout pelanggan maupun kasir.</p>
                                            </div>
                                        </div>

                                        <div className="bg-white p-6 rounded-3xl shadow-sm border border-zinc-200">
                                            <div className="flex justify-between items-center mb-4 border-b border-zinc-100 pb-2">
                                                <h3 className="font-black text-lg text-zinc-800">Manajemen Data (Backup)</h3>
                                            </div>
                                            <div className="space-y-4">
                                                <div className="bg-green-50 text-green-700 p-3 rounded-xl border border-green-200 flex items-start space-x-3 text-sm">
                                                    <svg className="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                                                    <div>
                                                        <p className="font-bold">Auto-Save Aktif</p>
                                                        <p className="text-xs opacity-80 mt-1">Data secara otomatis tersimpan secara real-time di memori perangkat (Local Storage). Gunakan fitur backup ini secara rutin untuk mencegah data hilang jika history browser dibersihkan.</p>
                                                    </div>
                                                </div>
                                                <div className="grid grid-cols-2 gap-3">
                                                    <button onClick={handleBackup} className="flex flex-col items-center justify-center p-4 bg-brand-50 hover:bg-brand-100 text-brand-700 rounded-xl border border-brand-200 transition-colors">
                                                        <svg className="w-6 h-6 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                                        <span className="font-bold text-sm">Download Backup</span>
                                                    </button>
                                                    <label className="flex flex-col items-center justify-center p-4 bg-zinc-50 hover:bg-zinc-100 text-zinc-700 rounded-xl border border-zinc-200 transition-colors cursor-pointer">
                                                        <svg className="w-6 h-6 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4 4m0 0l-4-4m4 4V4" /></svg>
                                                        <span className="font-bold text-sm">Restore Data</span>
                                                        <input type="file" accept=".json" onChange={handleRestore} className="hidden" />
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </main>
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
