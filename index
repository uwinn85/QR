                                            <button type="button" onClick={() => setCustomerOrderType('dine-in')} className={`flex-1 flex items-center justify-center space-x-2 py-2.5 text-sm font-bold rounded-lg transition-all ${customerOrderType === 'dine-in' ? 'bg-white shadow-sm text-brand-600' : 'text-zinc-500 hover:text-zinc-700'}`}>
                                                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                                <span>Makan di Tempat</span>
                                            </button>
                                            <button type="button" onClick={() => setCustomerOrderType('takeaway')} className={`flex-1 flex items-center justify-center space-x-2 py-2.5 text-sm font-bold rounded-lg transition-all ${customerOrderType === 'takeaway' ? 'bg-white shadow-sm text-brand-600' : 'text-zinc-500 hover:text-zinc-700'}`}>
                                                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                                                <span>Bawa Pulang</span>
                                            </button>
                                        </div>
                                    </div>

                                    {customerOrderType === 'dine-in' && (
                                        <div>
                                            <label className="text-xs font-bold text-zinc-500 uppercase tracking-wider mb-2 block">Nomor Meja</label>
                                            <input type="text" placeholder="Contoh: 12, VIP-1" required={customerOrderType === 'dine-in'} value={customerTable} onChange={(e) => setCustomerTable(e.target.value)} className="w-full px-5 py-4 bg-zinc-50 border border-zinc-200 rounded-xl text-center text-lg font-bold focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200 transition-all uppercase" />
