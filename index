                                <div className="w-14 h-14 bg-brand-600/20 text-brand-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
                                    <svg className="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                </div>
                                <h2 className="text-2xl font-bold text-white mb-2 text-center">Login Staff</h2>
                                <p className="text-xs text-zinc-400 text-center mb-6">Masukkan username dan PIN kasir/admin.</p>
                                
