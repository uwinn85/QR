                            .flex { display: flex; justify-content: space-between; }
                            .qris-box { text-align: center; margin: 10px 0; }
                            .qris-box img { width: 120px; height: 120px; }
                        </style>
                    </head>
                    <body>
                        <div class="center bold" style="font-size: 14px;">${settings.restoName}</div>
                        <div class="center" style="font-size: 10px;">Struk Pembayaran Resmi</div>
                        <div class="line"></div>
                        <div>ID Pesanan: ${order.id}</div>
                        <div>Waktu: ${new Date(order.time).toLocaleString('id-ID')}</div>
                        <div>Meja / Tipe: ${order.table} (${order.orderType})</div>
                        <div>Kasir/Sumber: ${currentUser?.name || order.source}</div>
                        <div class="line"></div>
                        <div>
                            ${order.items.map(i => `
                                <div>${i.quantity}x ${i.name}</div>
                                <div class="flex">
                                    <span>  @ Rp ${i.price.toLocaleString('id-ID')}</span>
                                    <span>Rp ${(i.price * i.quantity).toLocaleString('id-ID')}</span>
                                </div>
                            `).join('')}
                        </div>
                        <div class="line"></div>
                        <div class="flex"><span>Subtotal:</span><span>Rp ${order.subtotal.toLocaleString('id-ID')}</span></div>
                        ${settings.taxRate > 0 ? `<div class="flex"><span>Pajak (${settings.taxRate}%):</span><span>Rp ${order.tax.toLocaleString('id-ID')}</span></div>` : ''}
                        ${settings.serviceCharge > 0 ? `<div class="flex"><span>Service (${settings.serviceCharge}%):</span><span>Rp ${order.service.toLocaleString('id-ID')}</span></div>` : ''}
                        <div class="line"></div>
                        <div class="flex bold" style="font-size: 13px;"><span>TOTAL:</span><span>Rp ${order.total.toLocaleString('id-ID')}</span></div>
                        <div class="center" style="margin-top: 5px;">Pembayaran: ${paymentName}</div>
                        
                        ${isQris ? `
                            <div class="line"></div>
                            <div class="center bold">QRIS PEMBAYARAN</div>
                            <div class="qris-box">
                                <img src="${qrisImgUrl}" alt="QRIS" />
                            </div>
                            <div class="center" style="font-size: 10px;">Scan untuk konfirmasi pembayaran</div>
                        ` : ''}

                        <div class="line"></div>
                        <div class="center" style="margin-top: 15px; font-size: 11px;">Terima Kasih Atas Kunjungan Anda!</div>
                        <script>
                            window.onload = function() { window.print(); window.close(); }
                        <\/script>
                    </body>
                    </html>
                `);
                printWindow.document.close();
            };

            const downloadReceiptImg = (order) => {
                const isQris = paymentMethods.find(p => p.id === order.paymentMethod)?.type === 'qris';
                
                // Kalkulasi tinggi kanvas dinamis
                let h = 320 + (order.items.length * 20);
                if (settings.taxRate > 0) h += 20;
                if (settings.serviceCharge > 0) h += 20;
                if (isQris) h += 220; // Tambahan untuk QRIS code dan label

                const canvas = document.createElement('canvas');
                canvas.width = 400;
                canvas.height = h;
                const ctx = canvas.getContext('2d');
                
                // Background putih
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = '#000000';
                ctx.font = 'bold 16px Courier New';
                ctx.textAlign = 'center';
                ctx.fillText(settings.restoName, canvas.width / 2, 30);

                ctx.font = '12px Courier New';
                ctx.fillText('Struk Pembayaran Resmi', canvas.width / 2, 50);

                ctx.textAlign = 'left';
                ctx.font = '12px Courier New';
                let y = 80;
                ctx.fillText(`ID Pesanan : ${order.id}`, 20, y); y += 20;
                ctx.fillText(`Waktu      : ${new Date(order.time).toLocaleString('id-ID')}`, 20, y); y += 20;
                ctx.fillText(`Meja/Tipe  : ${order.table} (${order.orderType})`, 20, y); y += 25;

                ctx.beginPath();
                ctx.setLineDash([4, 2]);
                ctx.moveTo(20, y); ctx.lineTo(380, y);
                ctx.stroke();
                ctx.setLineDash([]);
                y += 20;

                order.items.forEach(i => {
                    ctx.fillText(`${i.quantity}x ${i.name}`, 20, y);
                    ctx.textAlign = 'right';
                    ctx.fillText(`Rp ${(i.price * i.quantity).toLocaleString('id-ID')}`, 380, y);
                    ctx.textAlign = 'left';
                    y += 20;
                });

                ctx.beginPath();
                ctx.setLineDash([4, 2]);
                ctx.moveTo(20, y); ctx.lineTo(380, y);
                ctx.stroke();
                ctx.setLineDash([]);
                y += 20;

                ctx.fillText(`Subtotal`, 20, y);
                ctx.textAlign = 'right';
                ctx.fillText(`Rp ${order.subtotal.toLocaleString('id-ID')}`, 380, y);
                ctx.textAlign = 'left';
                y += 20;

                if(settings.taxRate > 0) {
                    ctx.fillText(`Pajak (${settings.taxRate}%)`, 20, y);
                    ctx.textAlign = 'right';
                    ctx.fillText(`Rp ${order.tax.toLocaleString('id-ID')}`, 380, y);
                    ctx.textAlign = 'left';
                    y += 20;
                }

                if(settings.serviceCharge > 0) {
                    ctx.fillText(`Service (${settings.serviceCharge}%)`, 20, y);
                    ctx.textAlign = 'right';
                    ctx.fillText(`Rp ${order.service.toLocaleString('id-ID')}`, 380, y);
                    ctx.textAlign = 'left';
                    y += 20;
                }

                ctx.beginPath();
                ctx.setLineDash([4, 2]);
                ctx.moveTo(20, y); ctx.lineTo(380, y);
                ctx.stroke();
                ctx.setLineDash([]);
                y += 25;

                ctx.font = 'bold 14px Courier New';
                ctx.fillText(`TOTAL`, 20, y);
                ctx.textAlign = 'right';
                ctx.fillText(`Rp ${order.total.toLocaleString('id-ID')}`, 380, y);
                ctx.textAlign = 'left';
                y += 30;

                const finishDownload = () => {
                    ctx.font = '12px Courier New';
                    ctx.textAlign = 'center';
                    ctx.fillText('Terima Kasih Atas Kunjungan Anda!', canvas.width / 2, y);

                    const dataUrl = canvas.toDataURL('image/png');
                    const a = document.createElement('a');
                    a.href = dataUrl;
                    a.download = `Struk-${order.id}.png`;
                    a.click();
                };

                // Generate QRIS code directly on canvas if applicable
                if (isQris) {
                    const dynQris = generateDynamicQris(settings.staticQris, Math.round(order.total));
                    const tempDiv = document.createElement('div');
                    // This generates a synchronous/local canvas, dodging CORS restrictions
                    new QRCode(tempDiv, { text: dynQris, width: 150, height: 150 });
                    
                    setTimeout(() => {
                        ctx.beginPath();
                        ctx.setLineDash([4, 2]);
                        ctx.moveTo(20, y); ctx.lineTo(380, y);
                        ctx.stroke();
                        ctx.setLineDash([]);
                        y += 25;
                        
                        ctx.font = 'bold 14px Courier New';
                        ctx.textAlign = 'center';
                        ctx.fillText('QRIS PEMBAYARAN', canvas.width / 2, y);
                        y += 15;

                        const qrCanvas = tempDiv.querySelector('canvas');
                        if (qrCanvas) {
                            ctx.drawImage(qrCanvas, (canvas.width - 150) / 2, y);
                            y += 170;
                        }
                        finishDownload();
                    }, 100);
                } else {
                    finishDownload();
                }
            };

            const handleBackup = () => {
                const data = { settings, paymentMethods, menuItems, orders, tables, staffUsers };
                const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Backup-RestoQR-${new Date().toISOString().slice(0,10)}.json`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            };

            const handleRestore = (e) => {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (event) => {
                    try {
                        const data = JSON.parse(event.target.result);
                        if (data.settings) setSettings(data.settings);
                        if (data.paymentMethods) setPaymentMethods(data.paymentMethods);
                        if (data.menuItems) setMenuItems(data.menuItems);
                        if (data.orders) setOrders(data.orders);
                        if (data.tables) setTables(data.tables);
                        if (data.staffUsers) setStaffUsers(data.staffUsers);
                        showCustomAlert('Restore Berhasil', 'Data sistem berhasil dipulihkan dari file backup.');
                    } catch (error) {
                        showCustomAlert('Restore Gagal', 'Format file backup tidak valid atau rusak.');
                    }
                    e.target.value = ''; // Reset file input
                };
                reader.readAsText(file);
            };

            return (
                <div className="min-h-screen">
                    {modalConfig.isOpen && (
                        <div className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 glass-panel">
                            <div className="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl text-center">
                                <div className="w-16 h-16 bg-brand-100 text-brand-600 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <svg className="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                </div>
                                <h3 className="text-lg font-black text-zinc-800 mb-2">{modalConfig.title}</h3>
                                <p className="text-zinc-600 text-sm mb-6">{modalConfig.message}</p>
                                <div className="flex gap-3">
                                    {modalConfig.onConfirm && (
                                        <button onClick={() => { closeCustomAlert(); modalConfig.onConfirm(); }} className="flex-1 bg-brand-600 text-white font-bold py-3 rounded-xl hover:bg-brand-700 shadow-md">
                                            Ya
                                        </button>
                                    )}
                                    <button onClick={closeCustomAlert} className="flex-1 bg-zinc-200 text-zinc-800 font-bold py-3 rounded-xl hover:bg-zinc-300 shadow-md">
                                        {modalConfig.onConfirm ? 'Batal' : 'OK'}
                                    </button>
                                </div>
                            </div>
                        </div>
                    )}

                    {receiptOrder && (
                        <div className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 glass-panel">
                            <div className="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl flex flex-col max-h-[90vh]">
                                <div className="flex justify-between items-center mb-4 border-b border-zinc-100 pb-3">
                                    <h3 className="text-lg font-black text-zinc-800">Struk Pembayaran</h3>
                                    <button onClick={() => setReceiptOrder(null)} className="text-zinc-400 hover:text-zinc-600">
                                        <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                </div>

                                <div className="flex-1 overflow-y-auto space-y-3 font-mono text-xs bg-zinc-50 p-4 rounded-2xl border border-zinc-200 text-zinc-700">
                                    <div className="text-center font-bold text-sm text-zinc-900">{settings.restoName}</div>
                                    <div className="text-center text-[10px] text-zinc-500">Struk Transaksi Resmi</div>
                                    <div className="border-b border-dashed border-zinc-300 pb-2"></div>
                                    <div>ID: {receiptOrder.id}</div>
                                    <div>Waktu: {new Date(receiptOrder.time).toLocaleString('id-ID')}</div>
                                    <div>Meja/Tipe: {receiptOrder.table} ({receiptOrder.orderType})</div>
                                    <div className="border-b border-dashed border-zinc-300 pb-2"></div>
                                    <div className="space-y-1">
                                        {receiptOrder.items.map((item, idx) => (
                                            <div key={idx} className="flex justify-between">
                                                <span>{item.quantity}x {item.name}</span>
