                                        ))}
                                    </div>
                                    <div className="border-b border-dashed border-zinc-300 pb-2"></div>
                                    <div className="flex justify-between"><span>Subtotal:</span><span>Rp {receiptOrder.subtotal.toLocaleString('id-ID')}</span></div>
                                    {settings.taxRate > 0 && <div className="flex justify-between"><span>Pajak ({settings.taxRate}%):</span><span>Rp {receiptOrder.tax.toLocaleString('id-ID')}</span></div>}
                                    {settings.serviceCharge > 0 && <div className="flex justify-between"><span>Service ({settings.serviceCharge}%):</span><span>Rp {receiptOrder.service.toLocaleString('id-ID')}</span></div>}
                                    <div className="border-b border-dashed border-zinc-300 pb-2"></div>
                                    <div className="flex justify-between font-bold text-sm text-zinc-900"><span>TOTAL:</span><span className="text-brand-600">Rp {receiptOrder.total.toLocaleString('id-ID')}</span></div>
                                    <div className="text-center pt-2 text-[10px]">Pembayaran: {paymentMethods.find(p=>p.id===receiptOrder.paymentMethod)?.name || receiptOrder.paymentMethod}</div>

                                    {paymentMethods.find(p => p.id === receiptOrder.paymentMethod)?.type === 'qris' && (
                                        <div className="pt-2 text-center">
                                            <div className="border-b border-dashed border-zinc-300 pb-2 mb-2"></div>
                                            <div className="font-bold mb-1">QRIS PEMBAYARAN</div>
                                            <div className="w-28 h-28 bg-white p-1 mx-auto border rounded">
                                                <img src={`https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(generateDynamicQris(settings.staticQris, Math.round(receiptOrder.total)))}`} alt="QRIS" className="w-full h-full" />
                                            </div>
                                        </div>
                                    )}
                                </div>

                                <div className="grid grid-cols-2 gap-3 mt-4">
                                    <button onClick={() => printReceipt(receiptOrder)} className="bg-brand-600 hover:bg-brand-700 text-white font-bold py-2.5 rounded-xl shadow-md text-sm flex flex-col items-center justify-center">
                                        <svg className="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                                        <span>Cetak Struk</span>
                                    </button>
                                    <button onClick={() => downloadReceiptImg(receiptOrder)} className="bg-zinc-900 hover:bg-zinc-800 text-white font-bold py-2.5 rounded-xl shadow-md text-sm flex flex-col items-center justify-center">
                                        <svg className="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                        <span>Simpan Gambar</span>
                                    </button>
                                </div>
                                <button onClick={() => setReceiptOrder(null)} className="mt-3 w-full bg-zinc-200 text-zinc-800 font-bold py-3 rounded-xl text-sm hover:bg-zinc-300">
                                    Tutup
                                </button>
                            </div>
                        </div>
                    )}

                    {view === 'landing' && (
                        <div className="min-h-screen flex flex-col items-center justify-center p-6 relative overflow-hidden">
                            <div className="absolute top-0 left-0 w-full h-full overflow-hidden z-0 opacity-10">
                                <svg className="absolute w-96 h-96 -top-10 -left-10 text-white transform rotate-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                            </div>

                            <div className="w-full max-w-md bg-white rounded-3xl shadow-2xl p-8 z-10 text-center">
                                <div className="w-20 h-20 bg-brand-100 text-brand-600 rounded-full flex items-center justify-center mx-auto mb-6">
                                    <svg className="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm14 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
                                </div>
                                <h1 className="text-3xl font-black text-zinc-800 mb-2">{settings.restoName}</h1>
                                <p className="text-zinc-500 mb-6">Selamat datang! Silakan pilih tipe pesanan & meja Anda.</p>
                                
                                <form onSubmit={handleCustomerLogin} className="space-y-4 text-left">
                                    <div>
                                        <label className="text-xs font-bold text-zinc-500 uppercase tracking-wider mb-2 block">Tipe Pesanan</label>
